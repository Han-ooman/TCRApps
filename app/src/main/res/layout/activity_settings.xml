<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_sys_color_background"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSettings"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_sys_color_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:title="Pengaturan"
        app:titleTextColor="@color/md_sys_color_on_surface"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="@color/md_sys_color_on_surface" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarSettings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- Appearance Section -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.TCRApps.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tampilan"
                        android:textColor="@color/md_sys_color_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mode Gelap"
                                android:textColor="@color/md_sys_color_on_surface"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Gunakan tema gelap untuk hemat baterai OLED"
                                android:textColor="@color/md_sys_color_on_surface_variant"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchDarkMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Satuan Jarak"
                                android:textColor="@color/md_sys_color_on_surface"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="km (kilometer) atau mi (mil)"
                                android:textColor="@color/md_sys_color_on_surface_variant"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutUnitDistance"
                            style="@style/Widget.TCRApps.TextInputLayout"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:hint="km"
                            app:endIconMode="clear_text"
                            app:endIconTint="@color/md_sys_color_on_surface_variant">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="km"
                                android:textColor="@color/md_sys_color_on_surface"
                                android:textSize="15sp"
                                android:enabled="false"
                                android:focusable="false"
                                android:clickable="true"
                                android:textAlignment="textEnd" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Data Section -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.TCRApps.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data &amp; Backup"
                        android:textColor="@color/md_sys_color_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportData"
                        style="@style/Widget.TCRApps.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:text="Ekspor Data (JSON)"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_save_24"
                        app:iconGravity="start"
                        app:iconPadding="8dp"
                        app:cornerRadius="22dp"
                        app:strokeColor="@color/md_sys_color_outline" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearData"
                        style="@style/Widget.TCRApps.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:text="Hapus Semua Data"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_delete_24"
                        app:iconGravity="start"
                        app:iconPadding="8dp"
                        app:cornerRadius="22dp"
                        app:strokeColor="@color/md_sys_color_error"
                        android:textColor="@color/md_sys_color_error" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- About Section -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.TCRApps.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tentang"
                        android:textColor="@color/md_sys_color_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAbout"
                        style="@style/Widget.TCRApps.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:text="Info Aplikasi"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_info_24"
                        app:iconGravity="start"
                        app:iconPadding="8dp"
                        app:cornerRadius="22dp"
                        app:strokeColor="@color/md_sys_color_outline" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>